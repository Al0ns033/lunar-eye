# Add this once in the http {} block of nginx.conf:
# limit_req_zone $binary_remote_addr zone=lunar_eye:10m rate=30r/m;

server {
    listen 80;
    server_name lunar-eye.it www.lunar-eye.it;

    # Create the HTTPS certificate with certbot, then redirect HTTP to HTTPS.
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 130s;
        limit_req zone=lunar_eye burst=20 nodelay;
    }
}
